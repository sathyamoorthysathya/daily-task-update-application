# ---------------------------------------------------------------------------
# Frontend environment. Copy to `frontend/.env` (or `.env.local`) and adjust.
# Only variables prefixed with VITE_ are exposed to browser code.
# ---------------------------------------------------------------------------

# Base URL the browser uses for API calls.
# The default "/api" is forwarded to the backend by the Vite dev/preview proxy,
# so no CORS setup is needed locally. For a build served separately from the API,
# set the absolute URL, e.g. https://api.example.com/api (and add the site origin
# to the backend's CORS_ORIGINS).
VITE_API_BASE_URL=/api

# Dev/preview server only (not bundled): where the /api proxy forwards requests.
API_PROXY_TARGET=http://localhost:3000
