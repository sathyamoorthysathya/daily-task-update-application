# Rendered by the nginx image at start-up (envsubst): ${API_UPSTREAM} is the API address.
server_tokens off;

# Real client IP for the API's rate limiting: nginx adds the connecting address to
# X-Forwarded-For, and the API trusts exactly one proxy hop (TRUST_PROXY=1).
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Profile pictures are limited to 2 MB by the API; leave room for multipart overhead.
  client_max_body_size 3m;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Liveness of the web container itself.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
    # The API sets its own security headers on API responses.
  }

  # Fingerprinted build assets: cache for a year.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Single-page application: unknown paths render index.html; never cache it.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
