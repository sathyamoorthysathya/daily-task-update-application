# Settings for docker-compose.yml (running the app with Docker on your machine).
# Optional: copy to `.env` (next to docker-compose.yml) to change the defaults.

# PostgreSQL in Docker. The host port defaults to 5433 so it does not clash with a
# PostgreSQL installed on the machine (5432).
POSTGRES_USER=dtu_user
POSTGRES_PASSWORD=dtu_password
POSTGRES_DB=daily_task_update
POSTGRES_PORT=5433

# The web app is served at http://localhost:<WEB_PORT>.
WEB_PORT=8080

# Optional: Google sign-in. Add http://localhost:8080 to the OAuth client's
# "Authorized JavaScript origins" in Google Cloud.
GOOGLE_CLIENT_ID=

# Optional: your own secrets (32+ characters each, different from each other).
# JWT_ACCESS_SECRET=
# CSRF_SECRET=
