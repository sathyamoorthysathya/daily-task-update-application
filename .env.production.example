# ---------------------------------------------------------------------------------------------
# Production settings for docker-compose.prod.yml. Copy to `.env.production` (git-ignored),
# replace every CHANGE_ME, and keep the file readable only by the deploy user (chmod 600).
#
# Generate secrets with:  openssl rand -base64 48
# Passwords used in DATABASE_URL must be URL-safe (letters, digits, - _ .), e.g.:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------------------------

# --- Database (used by the postgres, migrate and api services) ---
POSTGRES_USER=dtu
POSTGRES_PASSWORD=CHANGE_ME_hex_password
POSTGRES_DB=daily_task_update

# --- Public URL of the site (as users type it, behind your TLS proxy) ---
FRONTEND_URL=https://tasks.example.com
CORS_ORIGINS=https://tasks.example.com

# --- Secrets (each at least 32 characters, all different) ---
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_random_characters
CSRF_SECRET=CHANGE_ME_another_32_random_characters

# --- HTTP ---
# Cookies are sent over HTTPS only (required in production).
COOKIE_SECURE=true
# Proxies in front of the API that add X-Forwarded-For: 1 = the bundled nginx only;
# 2 = a load balancer / TLS proxy in front of nginx.
TRUST_PROXY=2
# The OpenAPI UI is for development; keep it off on the public site.
SWAGGER_ENABLED=false

# --- Email (password reset). Required in production. ---
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM=Daily Task Update <no-reply@example.com>

# --- Google sign-in (optional; leave empty to disable) ---
GOOGLE_CLIENT_ID=

# --- Excel synchronisation and monitoring ---
EXCEL_SYNC_WORKER_ENABLED=true
# Webhook (Slack/Teams/incident tool) receiving alerts as JSON: failed Excel syncs and
# unexpected server errors. Strongly recommended.
ALERT_WEBHOOK_URL=
LOG_FORMAT=json

# --- Limits ---
MAX_WORKBOOKS_PER_USER=20

# --- Published port of the web container (bind to localhost behind a reverse proxy) ---
WEB_BIND=127.0.0.1
WEB_PORT=8080
