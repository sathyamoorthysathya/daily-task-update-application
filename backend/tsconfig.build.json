{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Inside dist: `nest build` / `nest start --watch` delete dist (deleteOutDir), and stale
    // incremental build info outside it would make the next build skip unchanged files.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
