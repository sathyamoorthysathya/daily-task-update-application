# ---------------------------------------------------------------------------
# Backend environment. Copy to `backend/.env` and adjust values.
# ---------------------------------------------------------------------------

# Runtime: development | test | production
NODE_ENV=development

# HTTP server
PORT=3000
# Prefix applied to every route, e.g. /api/health
API_PREFIX=api

# Comma-separated list of origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Swagger UI at /<API_PREFIX>/docs. Default: on, except when NODE_ENV=production.
SWAGGER_ENABLED=true

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# - PostgreSQL installed on this machine (scripts/setup-local-postgres.sql): port 5432 (below)
# - PostgreSQL in Docker (`npm run db:up`): port 5433
DATABASE_URL="postgresql://dtu_user:dtu_password@localhost:5432/daily_task_update?schema=public"

# Public URL of the web client (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Proxies whose X-Forwarded-For is trusted (client IPs for rate limiting and the audit log):
# false, true (proxy on loopback), a hop count (1 = one proxy, e.g. the Docker nginx),
# or addresses/subnets such as `loopback, 10.0.0.0/8`. Wrong values break rate limiting.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Authentication
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
# In production, placeholder or low-entropy secrets are rejected at startup:
# generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
CSRF_SECRET=change-me-to-a-different-random-string-of-32-plus-chars
# Access token lifetime (seconds) and refresh token / session lifetime (days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (cookies over HTTPS only)
COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30

# Google OAuth 2.0 Web client ID (Google Cloud Console > APIs & Services > Credentials).
# Leave empty to disable "Continue with Google".
GOOGLE_CLIENT_ID=

# Rate limiting (in-memory: one API instance, or a shared store for several)
# Login attempts per IP+email / per email from any IP, per 15 minutes
LOGIN_RATE_LIMIT=5
LOGIN_ACCOUNT_RATE_LIMIT=20
# Requests per minute: public auth endpoints per IP / any endpoint per IP / task changes per session
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=300
WRITE_RATE_LIMIT=60
# A session ends this many days after sign-in, however often it is refreshed
SESSION_MAX_DAYS=30

# Email: SMTP connection URL, e.g. smtp://user:password@smtp.example.com:587
# When empty (development), emails such as password reset links are printed in the API log.
SMTP_URL=
MAIL_FROM="Daily Task Update <no-reply@localhost>"

# ---------------------------------------------------------------------------
# Excel workbooks
# ---------------------------------------------------------------------------
# Where .xlsx files are stored (absolute path, or relative to the backend folder).
# Must be persistent (a mounted volume in containers) and backed up together with the database.
WORKBOOK_STORAGE_DIR=storage/workbooks
MAX_WORKBOOKS_PER_USER=20
# Dated entries (Excel rows) per workbook; every change rebuilds the file in memory
MAX_ENTRIES_PER_WORKBOOK=10000

# ---------------------------------------------------------------------------
# Excel synchronisation (transactional outbox + background worker)
# ---------------------------------------------------------------------------
# Run the worker in this process. Disable it on instances that should only serve the API.
EXCEL_SYNC_WORKER_ENABLED=true
EXCEL_SYNC_POLL_MS=2000
EXCEL_SYNC_CONCURRENCY=2
# Retries: delay = base * 2^(attempt-1), capped at max, with +/-20% jitter.
EXCEL_SYNC_MAX_ATTEMPTS=8
EXCEL_SYNC_RETRY_BASE_MS=5000
EXCEL_SYNC_RETRY_MAX_MS=900000
# A job "processing" for longer than this is considered abandoned and is picked up again.
EXCEL_SYNC_LEASE_MS=120000
# Optional: receives a JSON alert when a sync job gives up (e.g. a Slack/Teams webhook URL).
ALERT_WEBHOOK_URL=

# Logging: text (development) or json (one JSON object per line, for log aggregation)
LOG_FORMAT=text
# One structured log line per HTTP request (default: on in production)
# ACCESS_LOG=true
